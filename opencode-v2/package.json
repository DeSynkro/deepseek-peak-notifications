    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/theme": "2.2.0",
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "@types/bun": "latest",
    "solid-js": "^1.9.0",
    "typescript": "^5.7.0"
  }
