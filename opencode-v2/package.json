{
  "name": "opencode-deepseek-peak-notifications",
  "version": "0.3.0",
  "description": "OpenCode TUI sidebar alert for DeepSeek peak and off-peak pricing",
  "type": "module",
  "license": "MIT",
  "author": "DeSynkro",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "deepseek",
    "tui",
    "sidebar"
  ],
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.tsx"
